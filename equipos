    const selector = document.getElementById("selectorEquipo");
    const menu = document.getElementById("menu");
    const detalle = document.getElementById("detalle");
    const contenido = document.getElementById("contenidoEquipo");

    const texto = (valor) =>
      valor === null || valor === undefined || valor === ""
        ? "Sin dato registrado"
        : String(valor);

    const crear = (etiqueta, clase, contenidoTexto) => {
      const elemento = document.createElement(etiqueta);
      if (clase) elemento.className = clase;
      if (contenidoTexto !== undefined) elemento.textContent = contenidoTexto;
      return elemento;
    };

    const agregarDato = (contenedor, nombre, valor, unidad = "") => {
      const dato = crear("div", "dato");
      dato.appendChild(crear("strong", "", nombre));
      const valorVisible = texto(valor);
      const span = crear(
        "span",
        valorVisible === "Sin dato registrado" ? "sin-dato" : "",
        valorVisible + (valorVisible !== "Sin dato registrado" && unidad ? " " + unidad : ""),
      );
      dato.appendChild(span);
      contenedor.appendChild(dato);
    };

    const agregarSeccion = (contenedor, titulo, valor) => {
      if (valor === null || valor === undefined || String(valor).trim() === "") return;
      const seccion = crear("section", "seccion");
      seccion.appendChild(crear("h3", "", titulo));
      seccion.appendChild(crear("p", "", String(valor)));
      contenedor.appendChild(seccion);
    };

    const mostrarMenu = () => {
      detalle.hidden = true;
      menu.hidden = false;
      document.title = "Equipos CPF Campo Opón";
      window.scrollTo(0, 0);
    };

    const mostrarEquipo = (id, agregarHistorial = true) => {
      const equipo = EQUIPOS.find((item) => item.id === id);
      if (!equipo) {
        mostrarMenu();
        return;
      }

      contenido.replaceChildren();

      const encabezado = crear("div", "encabezado-equipo");
      encabezado.appendChild(crear("span", "tag", equipo.tag || equipo.id));
      encabezado.appendChild(crear("h2", "", equipo.name));
      encabezado.appendChild(crear("p", "", texto(equipo.location)));
      contenido.appendChild(encabezado);

      const datos = crear("div", "datos");
      agregarDato(datos, "ID", equipo.id);
      agregarDato(datos, "Tag", equipo.tag);
      agregarDato(datos, "Fabricante", equipo.manufacturer);
      agregarDato(datos, "Modelo", equipo.model);
      agregarDato(datos, "Número de serie", equipo.serial);
      agregarDato(datos, "Año", equipo.year);
      agregarDato(datos, "Horas", equipo.hours, "h");
      agregarDato(datos, "Potencia", equipo.powerKw, "kW");
      agregarDato(datos, "Capacidad", equipo.capacityKva, "kVA");
      contenido.appendChild(datos);

      agregarSeccion(contenido, "Estado consolidado", equipo.status);
      agregarSeccion(contenido, "Especificaciones técnicas", equipo.specifications);
      agregarSeccion(contenido, "Fallas e historial", equipo.history);
      agregarSeccion(contenido, "Recomendaciones y soluciones", equipo.recommendations);
      agregarSeccion(contenido, "Materiales y repuestos", equipo.materials);
      agregarSeccion(contenido, "Costos registrados", equipo.costs);
      agregarSeccion(contenido, "Personal o proveedor", equipo.personnel);
      agregarSeccion(contenido, "Pendientes de validación", equipo.pending);
      agregarSeccion(contenido, "Observaciones", equipo.observations);
      agregarSeccion(contenido, "Fuentes y referencias", equipo.sources);
      agregarSeccion(contenido, "Archivos relacionados", equipo.files);

      menu.hidden = true;
      detalle.hidden = false;
      selector.value = equipo.id;
      document.title = (equipo.tag || equipo.id) + " - " + equipo.name;
      window.scrollTo(0, 0);

      if (agregarHistorial) {
        history.pushState({ equipo: equipo.id }, "", "#equipo=" + encodeURIComponent(equipo.id));
      }
    };

    EQUIPOS.forEach((equipo) => {
      const opcion = document.createElement("option");
      opcion.value = equipo.id;
      opcion.textContent = (equipo.tag || equipo.id) + " — " + equipo.name;
      selector.appendChild(opcion);
    });

    document.getElementById("verEquipo").addEventListener("click", () => {
      mostrarEquipo(selector.value);
    });

    selector.addEventListener("keydown", (evento) => {
      if (evento.key === "Enter") mostrarEquipo(selector.value);
    });

    document.getElementById("volver").addEventListener("click", () => {
      if (location.hash.startsWith("#equipo=")) {
        history.back();
      } else {
        mostrarMenu();
      }
    });

    window.addEventListener("popstate", () => {
      const id = decodeURIComponent(location.hash.replace("#equipo=", ""));
      if (location.hash.startsWith("#equipo=") && EQUIPOS.some((item) => item.id === id)) {
        mostrarEquipo(id, false);
      } else {
        mostrarMenu();
      }
    });

    const idInicial = decodeURIComponent(location.hash.replace("#equipo=", ""));
    if (location.hash.startsWith("#equipo=") && EQUIPOS.some((item) => item.id === idInicial)) {
      mostrarEquipo(idInicial, false);
    } else {
      mostrarMenu();
    }
  </script>
