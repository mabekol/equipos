<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Equipos CPF Campo Opón</title>
  <style>
    :root {
      --azul: #17344f;
      --azul-claro: #eaf1f6;
      --borde: #ced8df;
      --texto: #202b34;
      --secundario: #60707d;
      --fondo: #f3f5f7;
      --blanco: #fff;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--fondo);
      color: var(--texto);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.5;
    }
    .contenedor {
      width: min(920px, calc(100% - 28px));
      margin: 28px auto;
    }
    header {
      margin-bottom: 18px;
      padding: 22px 24px;
      border-radius: 8px;
      background: var(--azul);
      color: var(--blanco);
    }
    header h1 {
      margin: 0 0 4px;
      font-size: 26px;
    }
    header p {
      margin: 0;
      color: #cfdae2;
      font-size: 14px;
    }
    .panel {
      padding: 24px;
      border: 1px solid var(--borde);
      border-radius: 8px;
      background: var(--blanco);
    }
    h2 {
      margin: 0 0 8px;
      color: var(--azul);
      font-size: 22px;
    }
    .instruccion {
      margin: 0 0 20px;
      color: var(--secundario);
    }
    label {
      display: block;
      margin-bottom: 7px;
      color: var(--azul);
      font-size: 14px;
      font-weight: bold;
    }
    select {
      width: 100%;
      min-height: 48px;
      padding: 10px 12px;
      border: 1px solid #aebdc8;
      border-radius: 6px;
      background: var(--blanco);
      color: var(--texto);
      font-size: 16px;
    }
    button {
      min-height: 44px;
      padding: 10px 18px;
      border: 1px solid var(--azul);
      border-radius: 6px;
      background: var(--azul);
      color: var(--blanco);
      font-size: 15px;
      font-weight: bold;
      cursor: pointer;
    }
    button:hover { background: #0f283e; }
    .boton-ver { margin-top: 14px; }
    .boton-atras {
      margin-bottom: 16px;
      background: var(--blanco);
      color: var(--azul);
    }
    .boton-atras:hover { background: var(--azul-claro); }
    .encabezado-equipo {
      margin-bottom: 18px;
      padding-bottom: 16px;
      border-bottom: 2px solid var(--azul);
    }
    .tag {
      display: inline-block;
      margin-bottom: 8px;
      padding: 4px 9px;
      border-radius: 4px;
      background: var(--azul);
      color: var(--blanco);
      font-size: 13px;
      font-weight: bold;
    }
    .encabezado-equipo p {
      margin: 4px 0 0;
      color: var(--secundario);
    }
    .datos {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-bottom: 18px;
      border-top: 1px solid var(--borde);
      border-left: 1px solid var(--borde);
    }
    .dato {
      padding: 11px 13px;
      border-right: 1px solid var(--borde);
      border-bottom: 1px solid var(--borde);
    }
    .dato strong {
      display: block;
      margin-bottom: 3px;
      color: var(--secundario);
      font-size: 11px;
      text-transform: uppercase;
    }
    .seccion {
      margin-top: 14px;
      padding: 16px 18px;
      border: 1px solid var(--borde);
      border-radius: 6px;
      background: #fbfcfd;
    }
    .seccion h3 {
      margin: 0 0 9px;
      color: var(--azul);
      font-size: 16px;
    }
    .seccion p {
      margin: 0;
      white-space: pre-line;
      overflow-wrap: anywhere;
      font-size: 14px;
    }
    .sin-dato {
      color: #7b8994;
      font-style: italic;
    }
    [hidden] { display: none !important; }
    footer {
      padding: 18px 0;
      color: var(--secundario);
      font-size: 12px;
      text-align: center;
    }
    @media (max-width: 620px) {
      .contenedor { margin-top: 14px; }
      header, .panel { padding: 18px; }
      .datos { grid-template-columns: 1fr; }
      header h1 { font-size: 22px; }
    }
    @media print {
      body { background: var(--blanco); }
      .contenedor { width: 100%; margin: 0; }
      header, #menu, .boton-atras, footer { display: none !important; }
      .panel { padding: 0; border: 0; }
    }
  </style>
</head>
<body>
  <main class="contenedor">
    <header>
      <h1>Equipos CPF Campo Opón</h1>
      <p>Consulta consolidada de información por equipo</p>
    </header>

    <section id="menu" class="panel">
      <h2>Seleccione un equipo</h2>
