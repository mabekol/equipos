      <label for="selectorEquipo">Equipo</label>
      <select id="selectorEquipo"></select>
      <button id="verEquipo" class="boton-ver" type="button">Ver información</button>
    </section>

    <section id="detalle" class="panel" hidden>
      <button id="volver" class="boton-atras" type="button">← Volver al menú</button>
      <div id="contenidoEquipo"></div>
    </section>

    <footer>Los datos pendientes deben confirmarse con la documentación o validación en campo.</footer>
  </main>

